#!/bin/bash
# The profile is created by the GUI as the logged-in user, never by Installer's root process.
console_user=$(/usr/bin/stat -f '%Su' /dev/console)
case "$console_user" in root|loginwindow|_mbsetupuser|'') exit 0 ;; esac
console_uid=$(/usr/bin/id -u "$console_user")
/bin/launchctl asuser "$console_uid" /usr/bin/sudo -u "$console_user" /usr/bin/open -a /Applications/LocalClipboard.app || true
exit 0
