#!/bin/bash
# The profile is created by the GUI as the logged-in user, never by Installer's root process.
# Older packages installed a separate removal launcher; maintenance is in the installer.
legacy='/Applications/Uninstall LocalClipboard.app'
if [[ ! -L "$legacy" && -d "$legacy" && ! -L "$legacy/Contents" && ! -L "$legacy/Contents/Info.plist" ]]; then
    if [[ $(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$legacy/Contents/Info.plist" 2>/dev/null) == org.localclipboard.uninstaller ]]; then
        /bin/rm -rf -- "$legacy"
    fi
fi
# The installer opens the application as its normal user, with their chosen language.
exit 0
