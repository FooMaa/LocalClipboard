#!/usr/bin/env python3
"""Reject packaged Mach-O dependencies that still need the developer's Qt installation."""
import pathlib
import subprocess
import sys

bundle = pathlib.Path(sys.argv[1]).resolve()
frameworks = bundle / "Contents/Frameworks"
executable = bundle / "Contents/MacOS"
magic = {b"\xfe\xed\xfa\xce", b"\xce\xfa\xed\xfe", b"\xfe\xed\xfa\xcf", b"\xcf\xfa\xed\xfe", b"\xca\xfe\xba\xbe", b"\xbe\xba\xfe\xca"}
seen, failures = set(), []
for candidate in bundle.rglob("*"):
    if not candidate.is_file():
        continue
    binary = candidate.resolve()
    if binary in seen:
        continue
    seen.add(binary)
    with binary.open("rb") as stream:
        if stream.read(4) not in magic:
            continue
    dependencies = subprocess.check_output(["otool", "-L", str(binary)], text=True).splitlines()[1:]
    # otool -L also lists the library's own install ID; it is not a runtime dependency.
    ids = set(subprocess.check_output(["otool", "-D", str(binary)], text=True).splitlines()[1:])
    for line in dependencies:
        if not line.startswith("\t"):
            continue
        dependency = line.strip().split(" (compatibility version", 1)[0]
        if dependency in ids:
            continue
        if dependency.startswith(("/usr/lib/", "/System/Library/")):
            continue
        if dependency.startswith("@rpath/"):
            relative = dependency[len("@rpath/"):]
            targets = [frameworks / relative, binary.parent / relative, executable / relative]
        elif dependency.startswith("@loader_path/"):
            targets = [binary.parent / dependency[len("@loader_path/"):]]
        elif dependency.startswith("@executable_path/"):
            targets = [executable / dependency[len("@executable_path/"):]]
        else:
            failures.append(f"{candidate.relative_to(bundle)}: external dependency {dependency}")
            continue
        if not any(target.is_file() and target.resolve().is_relative_to(bundle) for target in targets):
            failures.append(f"{candidate.relative_to(bundle)}: unresolved dependency {dependency}")
if failures:
    sys.exit("\n".join(failures))
print("macOS bundle dependencies are self-contained.")
