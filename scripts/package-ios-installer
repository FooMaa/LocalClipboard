#!/usr/bin/env bash
# The source installer can be assembled before Xcode / the iOS SDK is available.
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
command -v zip >/dev/null || { echo 'zip is required to assemble the iOS source installer.' >&2; exit 1; }
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir -p "$ROOT/dist" "$stage/installer/Source"
cp "$ROOT/CMakeLists.txt" "$stage/installer/Source/"
for directory in src cmake ios third_party scripts packaging assets; do
    cp -R "$ROOT/$directory" "$stage/installer/Source/"
done
cp "$ROOT/packaging/ios/install.sh" "$ROOT/packaging/common/language.sh" "$ROOT/packaging/ios/README.md" "$stage/installer/"
chmod +x "$stage/installer/"*.sh
# Create a fresh archive so removed source files cannot survive a later build.
(cd "$stage/installer" && zip -qr "$stage/LocalClipboard-ios-installer.zip" .)
mv "$stage/LocalClipboard-ios-installer.zip" "$ROOT/dist/LocalClipboard-ios-installer.zip"
printf 'Xcode source installer: %s/dist/LocalClipboard-ios-installer.zip\n' "$ROOT"
