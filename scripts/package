#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
format=native
build_dir=
config=Release
usage() { echo "Usage: scripts/package [-t native|linux|macos|windows|android|ios|deb|sh|apk] [-b BUILD_DIR] [-c CONFIG]"; }
fail() { echo "Error: $*" >&2; exit 1; }
while getopts ':t:b:c:h' option; do
    case "$option" in
        t) format=$OPTARG ;; b) build_dir=$OPTARG ;; c) config=$OPTARG ;;
        h) usage; exit 0 ;; *) usage >&2; exit 1 ;;
    esac
done
shift "$((OPTIND - 1))"
[[ $# == 0 ]] || { usage >&2; exit 1; }
if [[ "$format" == native ]]; then
    case "$(uname -s)" in Darwin) format=macos ;; Linux) format=linux ;; MINGW*|MSYS*|CYGWIN*) format=windows ;; *) fail "Unsupported host" ;; esac
fi
mkdir -p "$ROOT/dist"
build_dir=${build_dir:-"$ROOT/build_$format"}
build_dir=$(cd "$build_dir" && pwd)
version=$(sed -n 's/^project(LocalClipboard VERSION \([^ ]*\).*/\1/p' "$ROOT/CMakeLists.txt")
[[ -n "$version" ]] || fail "Project version missing"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
case "$format" in
    linux|deb|sh)
        [[ $(uname -s) == Linux ]] || fail "Linux packaging requires Linux"
        [[ -f "$build_dir/LocalClipboard" ]] || fail "Build Linux first"
        arch=$(dpkg --print-architecture)
        mkdir -p "$stage/root/DEBIAN" "$stage/root/usr/bin" "$stage/root/usr/share/applications" "$stage/root/usr/share/doc/localclipboard"
        mkdir -p "$stage/root/usr/share/icons/hicolor/scalable/apps"
        cp "$ROOT/assets/icons/localclipboard.svg" "$stage/root/usr/share/icons/hicolor/scalable/apps/"
        for size in 16 24 32 48 64 128 256 512; do
            mkdir -p "$stage/root/usr/share/icons/hicolor/${size}x${size}/apps"
            cp "$ROOT/assets/icons/localclipboard-$size.png" "$stage/root/usr/share/icons/hicolor/${size}x${size}/apps/localclipboard.png"
        done
        cp "$build_dir/LocalClipboard" "$stage/root/usr/bin/localclipboard"
        cp "$ROOT/packaging/linux/localclipboard.desktop" "$stage/root/usr/share/applications/"
        cp "$ROOT/third_party/monocypher/LICENCE.md" "$stage/root/usr/share/doc/localclipboard/monocypher-license"
        cp "$ROOT/third_party/zxing/LICENSE" "$stage/root/usr/share/doc/localclipboard/zxing-license"
        cp "$ROOT/third_party/zxing/NOTICES.txt" "$stage/root/usr/share/doc/localclipboard/zxing-notices"
        mkdir -p "$stage/root/debian"
        cat > "$stage/root/debian/control" <<'CONTROL'
Source: localclipboard
Section: utils
Priority: optional
Maintainer: LocalClipboard <dev@localclipboard.org>

Package: localclipboard
Architecture: any
Description: Personal encrypted LAN clipboard synchronization
CONTROL
        runtime_depends=$(cd "$stage/root" && dpkg-shlibdeps -O -e"$stage/root/usr/bin/localclipboard")
        runtime_depends=${runtime_depends#shlibs:Depends=}
        rm -rf "$stage/root/debian"
        cat > "$stage/root/DEBIAN/control" <<CONTROL
Package: localclipboard
Version: $version
Section: utils
Priority: optional
Architecture: $arch
Maintainer: LocalClipboard <dev@localclipboard.org>
Depends: $runtime_depends, qt6-qpa-plugins, qml6-module-qtquick, qml6-module-qtquick-window, qml6-module-qtquick-layouts, qml6-module-qtquick-controls, qml6-module-qtquick-templates, qml6-module-qtqml-workerscript, gstreamer1.0-plugins-good, policykit-1
Description: Personal encrypted LAN clipboard synchronization
 Text, photos and files. Register separate personal profiles on first launch.
CONTROL
        package="$ROOT/dist/LocalClipboard-linux-$arch.deb"
        dpkg-deb --build --root-owner-group "$stage/root" "$package"
        cp "$package" "$stage/localclipboard.deb"
        cp "$ROOT/packaging/common/language.sh" "$stage/language.sh"
        cp "$ROOT/packaging/linux/install.sh" "$stage/install.sh"
        output="$ROOT/dist/LocalClipboard-linux-$arch-installer.sh"
        cat > "$output" <<'INSTALLER'
#!/usr/bin/env bash
set -euo pipefail
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
line=$(awk '/^__ARCHIVE_BELOW__$/ {print NR + 1; exit}' "$0")
tail -n +"$line" "$0" | tar xz -C "$stage"
bash "$stage/install.sh"
exit 0
__ARCHIVE_BELOW__
INSTALLER
        tar czf "$stage/payload.tar.gz" -C "$stage" localclipboard.deb install.sh language.sh
        cat "$stage/payload.tar.gz" >> "$output"
        chmod +x "$output"
        ;;
    macos)
        [[ $(uname -s) == Darwin ]] || fail "macOS packaging requires macOS"
        app="$build_dir/LocalClipboard.app"
        [[ -d "$app" ]] || app="$build_dir/$config/LocalClipboard.app"
        [[ -d "$app" ]] || fail "Build macOS first"
        command -v macdeployqt >/dev/null || fail "macdeployqt must be on PATH"
        mkdir -p "$stage/root/Applications" "$stage/scripts"
        cp -R "$app" "$stage/root/Applications/"
        python3 "$ROOT/scripts/prepare-qml-imports" "$ROOT/qml" "$stage/qml-imports"
        deploy_args=(-always-overwrite -no-plugins "-qmldir=$ROOT/qml" "-qmlimport=$stage/qml-imports")
        # Older Qt releases (including CI's 6.8) do not accept -no-codesign.
        # Defer signing when supported; the completed bundle is signed below.
        if [[ "$(macdeployqt -help 2>&1)" == *"-no-codesign"* ]]; then
            deploy_args+=(-no-codesign)
        fi
        command -v qtpaths >/dev/null || fail "qtpaths must be on PATH"
        plugin_root=$(qtpaths --query QT_INSTALL_PLUGINS)
        deployed_app="$stage/root/Applications/LocalClipboard.app"
        # Deploy only the platform, widget style and raster codecs used by this app.
        # A full Qt installation may also contain PDF/QML/virtual-keyboard plugins.
        for plugin in platforms/libqcocoa.dylib styles/libqmacstyle.dylib \
            imageformats/libqjpeg.dylib imageformats/libqgif.dylib imageformats/libqico.dylib \
            imageformats/libqicns.dylib imageformats/libqtga.dylib imageformats/libqwbmp.dylib \
            imageformats/libqtiff.dylib imageformats/libqwebp.dylib multimedia/libdarwinmediaplugin.dylib; do
            [[ -f "$plugin_root/$plugin" ]] || continue
            mkdir -p "$deployed_app/Contents/PlugIns/$(dirname "$plugin")"
            cp "$plugin_root/$plugin" "$deployed_app/Contents/PlugIns/$plugin"
            deploy_args+=("-executable=$deployed_app/Contents/PlugIns/$plugin")
        done
        [[ -f "$deployed_app/Contents/PlugIns/multimedia/libdarwinmediaplugin.dylib" ]] || fail "Qt macOS camera backend missing"
        [[ -f "$deployed_app/Contents/PlugIns/platforms/libqcocoa.dylib" ]] || fail "Qt Cocoa platform plugin missing"
        deploy_args+=("-libpath=$(qtpaths --query QT_INSTALL_LIBS)")
        macdeployqt "$stage/root/Applications/LocalClipboard.app" "${deploy_args[@]}"
        mkdir -p "$deployed_app/Contents/Resources"
        printf '[Paths]\nPlugins=PlugIns\nQmlImports=Resources/qml\n' > "$deployed_app/Contents/Resources/qt.conf"
        mkdir -p "$stage/root/Applications/LocalClipboard.app/Contents/Resources/licenses"
        cp "$ROOT/third_party/monocypher/LICENCE.md" "$stage/root/Applications/LocalClipboard.app/Contents/Resources/licenses/monocypher.txt"
        cp "$ROOT/third_party/zxing/LICENSE" "$deployed_app/Contents/Resources/licenses/zxing.txt"
        cp "$ROOT/third_party/zxing/NOTICES.txt" "$deployed_app/Contents/Resources/licenses/zxing-notices.txt"
        if [[ -n ${MACOS_APP_SIGN_IDENTITY:-} ]]; then
            codesign --force --deep --options runtime --timestamp --entitlements "$ROOT/packaging/macos/entitlements.plist" --sign "$MACOS_APP_SIGN_IDENTITY" "$stage/root/Applications/LocalClipboard.app"
        else
            codesign --force --deep --sign - "$stage/root/Applications/LocalClipboard.app"
        fi
        codesign --verify --deep --strict "$stage/root/Applications/LocalClipboard.app"
        python3 "$ROOT/scripts/verify-macos-bundle" "$stage/root/Applications/LocalClipboard.app"
        ditto -c -k "$stage/root/Applications" "$ROOT/dist/LocalClipboard-macos-package.zip"
        cp "$ROOT/packaging/macos/postinstall" "$stage/scripts/postinstall"
        cp "$ROOT/packaging/macos/preinstall" "$stage/scripts/preinstall"
        chmod +x "$stage/scripts/preinstall" "$stage/scripts/postinstall"
        pkgbuild --analyze --root "$stage/root" "$stage/components.plist"
        python3 - "$stage/components.plist" <<'PY'
import plistlib, sys
with open(sys.argv[1], 'rb') as stream:
    components = plistlib.load(stream)
for component in components:
    component['BundleIsRelocatable'] = False
with open(sys.argv[1], 'wb') as stream:
    plistlib.dump(components, stream)
PY
        pkgbuild --root "$stage/root" --identifier org.localclipboard --version "$version" \
            --component-plist "$stage/components.plist" --install-location / --scripts "$stage/scripts" "$stage/component.pkg"
        mkdir -p "$stage/removal-scripts"
        cp "$ROOT/packaging/macos/remove-postinstall" "$stage/removal-scripts/postinstall"
        chmod +x "$stage/removal-scripts/postinstall"
        pkgbuild --nopayload --identifier org.localclipboard.removal --version "$version" \
            --scripts "$stage/removal-scripts" "$stage/removal.pkg"
        "$ROOT/scripts/package-macos-installer" "$stage/component.pkg" "$stage/removal.pkg" "$ROOT/dist/LocalClipboard-macos-installer.dmg"
        rm -f "$ROOT/dist/LocalClipboard-macos-installer.pkg"
        ;;
    ios)
        [[ $(uname -s) == Darwin ]] || fail "iOS packaging requires macOS"
        app="$build_dir/$config-iphoneos/LocalClipboard.app"
        [[ -d "$app" ]] || app="$build_dir/$config/LocalClipboard.app"
        [[ -d "$app" ]] || fail "Build the iOS device application first"
        [[ $(/usr/libexec/PlistBuddy -c 'Print :CFBundleSupportedPlatforms:0' "$app/Info.plist") == iPhoneOS ]] \
            || fail "Expected an iPhoneOS device build, not macOS or Simulator"
        mkdir -p "$stage/package"
        cp -R "$app" "$stage/package/LocalClipboard.app"
        cp "$ROOT/packaging/ios/README.md" "$stage/package/README.md"
        ditto -c -k "$stage/package" "$ROOT/dist/LocalClipboard-ios-package.zip"
        "$ROOT/scripts/package-ios-installer"
        ;;
    windows)
        [[ "$config" != Debug ]] || fail "Redistributable Windows packages require Release/RelWithDebInfo; use build -n for a Debug application"
        # Chocolatey can install NSIS outside the current shell's PATH. Convert
        # explicit Windows paths for Git Bash and check both Program Files roots.
        nsis=
        if [[ -n ${NSIS_EXE:-} ]]; then
            nsis=$(command -v "$NSIS_EXE" || true)
            [[ -n "$nsis" ]] || nsis=$(cygpath -u "$NSIS_EXE")
        else
            nsis=$(command -v makensis || command -v makensis.exe || true)
            if [[ -z "$nsis" ]]; then
                for variable in ProgramW6432 ProgramFiles 'ProgramFiles(x86)'; do
                    program_files=$(printenv "$variable" || true)
                    [[ -n "$program_files" ]] || continue
                    candidate="$(cygpath -u "$program_files")/NSIS/makensis.exe"
                    if [[ -x "$candidate" ]]; then nsis=$candidate; break; fi
                done
            fi
        fi
        [[ -n "$nsis" && -x "$nsis" ]] || fail "Install NSIS or set NSIS_EXE to makensis.exe (resolved: $nsis)"
        binary="$build_dir/$config/LocalClipboard.exe"
        [[ -f "$binary" ]] || binary="$build_dir/LocalClipboard.exe"
        [[ -f "$binary" ]] || fail "Build Windows first"
        command -v windeployqt >/dev/null || fail "windeployqt must be on PATH"
        deploy="$stage/deploy"
        mkdir -p "$deploy/licenses"
        cp "$binary" "$deploy/LocalClipboard.exe"
        cp "$ROOT/third_party/monocypher/LICENCE.md" "$deploy/licenses/monocypher.txt"
        cp "$ROOT/third_party/zxing/LICENSE" "$deploy/licenses/zxing.txt"
        cp "$ROOT/third_party/zxing/NOTICES.txt" "$deploy/licenses/zxing-notices.txt"
        windeployqt --release --no-compiler-runtime --no-translations --qmldir "$ROOT/qml" "$deploy/LocalClipboard.exe"
        # App-local MSVC runtime avoids requiring an administrator to install VC redist.
        : "${VCToolsRedistDir:?Run packaging from the MSVC developer environment (VCToolsRedistDir missing)}"
        crt_root=$(cygpath -u "$VCToolsRedistDir")
        crt_arch=${VSCMD_ARG_TGT_ARCH:-x64}
        crt_dir=
        while IFS= read -r -d '' candidate; do crt_dir=$(dirname "$candidate"); break; done \
            < <(find "$crt_root/$crt_arch" -type f -name msvcp140.dll -print0)
        [[ -n "$crt_dir" ]] || fail "MSVC redistributable CRT DLLs missing for $crt_arch"
        cp "$crt_dir/"*.dll "$deploy/"
        deploy_win=$(cygpath -w "$deploy")
        output_win=$(cygpath -w "$ROOT/dist/LocalClipboard-windows-package.zip")
        export LOCALCLIPBOARD_DEPLOY="$deploy_win" LOCALCLIPBOARD_PACKAGE="$output_win"
        powershell.exe -NoProfile -Command 'Compress-Archive -Path (Join-Path $env:LOCALCLIPBOARD_DEPLOY "*") -DestinationPath $env:LOCALCLIPBOARD_PACKAGE -Force'
        MSYS_NO_PATHCONV=1 "$nsis" "-DAPP_VERSION=$version" "-DDEPLOY_DIR=$deploy_win" \
            "-DOUTPUT_FILE=$(cygpath -w "$ROOT/dist/LocalClipboard-windows-installer.exe")" \
            "$(cygpath -w "$ROOT/packaging/windows/installer.nsi")"
        ;;
    android|apk)
        apk=
        while IFS= read -r -d '' candidate; do
            [[ $(basename "$candidate") != *unaligned* && $(basename "$candidate") != *unsigned* ]] || continue
            [[ -z "$apk" ]] || fail "Multiple installable APKs found; use a clean build directory for one configuration/ABI"
            apk=$candidate
        done < <(find "$build_dir" -type f -path '*/outputs/apk/*' -name '*.apk' -print0)
        [[ -n "$apk" ]] || fail "No signed APK found; Debug is installable, Release needs signing"
        cp "$apk" "$ROOT/dist/LocalClipboard-android-package.apk"
        mkdir -p "$stage/android-installer"
        cp "$apk" "$stage/android-installer/LocalClipboard.apk"
        cp "$ROOT/packaging/android/install.sh" "$ROOT/packaging/android/install.ps1" "$ROOT/packaging/common/language.sh" "$ROOT/packaging/android/README.md" "$stage/android-installer/"
        chmod +x "$stage/android-installer/"*.sh
        cp "$ROOT/third_party/monocypher/LICENCE.md" "$stage/android-installer/monocypher-license.txt"
        cp "$ROOT/third_party/zxing/LICENSE" "$stage/android-installer/zxing-license.txt"
        cp "$ROOT/third_party/zxing/NOTICES.txt" "$stage/android-installer/zxing-notices.txt"
        (cd "$stage/android-installer" && zip -qr "$ROOT/dist/LocalClipboard-android-installer.zip" .)
        ;;
    *) usage >&2; exit 1 ;;
esac
printf 'Packages and installers: %s/dist/\n' "$ROOT"
